# VLAILA API configuration.
# Copy to server/.env and edit. Every value here has a working default --
# with no .env at all the API runs on SQLite with the offline reasoning tier.

# --- storage ---------------------------------------------------------------
# VLAILA_DATABASE_URL=postgresql+psycopg://vlaila:vlaila@localhost:5432/vlaila

# --- reasoning -------------------------------------------------------------
# offline | anthropic | openai | ollama
VLAILA_LLM_PROVIDER=offline

# Option A -- cloud (best reasoning quality)
# VLAILA_LLM_PROVIDER=anthropic
# VLAILA_ANTHROPIC_API_KEY=sk-ant-...
# VLAILA_MODEL_REASONING=claude-opus-5

# Option B -- fully on-premise. No session data leaves the network.
# VLAILA_LLM_PROVIDER=ollama
# VLAILA_OLLAMA_BASE_URL=http://localhost:11434
# VLAILA_MODEL_REASONING=llama3.1:70b
# VLAILA_MODEL_FAST=gemma2:9b

# --- behaviour -------------------------------------------------------------
# Seconds before the agent gives up on a model tier and serves the static hint.
VLAILA_AGENT_TIMEOUT_SECONDS=2.0
# Minimum confidence before a WARN is allowed to fire.
VLAILA_WARN_CONFIDENCE_THRESHOLD=0.9
VLAILA_RATE_LIMIT_EVENTS_PER_MINUTE=60
VLAILA_RATE_LIMIT_CHAT_PER_MINUTE=20
VLAILA_SCRUB_PII=true
